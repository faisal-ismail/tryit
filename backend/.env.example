# YouCam S2S v2.0 REST API Credentials (https://yce.perfectcorp.com/)
YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_SECRET_KEY=your_youcam_secret_key_optional
YOUCAM_BASE_URL=https://yce-api-01.perfectcorp.com

# Google Gemini 2.5 Flash API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Resilient Hackathon Fallback Mode
# Set to "auto" (uses live APIs when keys are configured, seamlessly falls back on error/rate-limit)
# Set to "true" to force instant high-speed simulation for offline/demo testing
# Set to "false" to enforce strict live API calls only
DEMO_FALLBACK_MODE=auto

# Public Base URL (used when deployed on cPanel or local server)
PUBLIC_BASE_URL=http://localhost:8000

